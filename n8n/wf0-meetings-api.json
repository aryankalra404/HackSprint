      "id": "4d85288c-2d1e-46dc-9c4f-bf419536ec3b",
      "name": "Read meeting",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// One meeting by id, with its brief and proposed panel\nconst id = $('GET /meeting').first().json.query.id;\nconst r = $input.all().map(i => i.json).find(r => String(r.id) === String(id));\nconst parse = s => { try { return s ? JSON.parse(s) : null; } catch { return null; } };\nif (!r) return [{ json: { error: 'not found' } }];\nreturn [{ json: {\n  meeting: { id: String(r.id), title: r.title, start: r.start, company: r.company, why: r.why, status: r.status, attendees: parse(r.attendees) || [] },\n  brief: parse(r.brief), proposal: parse(r.proposal),\n} }];"
      },
      "id": "73c2e0b7-bbb9-440a-847f-63c18a9a7825",
      "name": "The meeting and its brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ],
      "alwaysOutputData": true
    },
    {
