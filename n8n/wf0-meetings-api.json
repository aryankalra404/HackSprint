      "id": "f94dd00c-bc22-46a4-934a-b495a8573187",
      "name": "Read meetings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Upcoming (and today's) meetings, soonest first\nconst since = Date.now() - 12 * 3600 * 1000;\nconst meetings = $input.all().map(i => i.json).filter(r => r.id && (!r.start || Date.parse(r.start) >= since))\n  .sort((a, b) => Date.parse(a.start || 0) - Date.parse(b.start || 0))\n  .map(r => ({ id: String(r.id), title: r.title, start: r.start, company: r.company, why: r.why, status: r.status,\n               attendees: (() => { try { return JSON.parse(r.attendees || '[]'); } catch { return []; } })() }));\nreturn [{ json: { meetings } }];"
      },
      "id": "2c92456c-7dbc-45e1-9b38-c8a502b89abc",
      "name": "Upcoming meetings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "e0f15480-28a8-459c-88f3-e9ee8cd2e9fa",
      "name": "Send meetings",
      "type": "n8n-nodes-base.respondToWebhook",
